# Database
MONGODB_URI=your_mongodb_connection_string

# Redis (Upstash)
UPSTASH_REDIS_URL=your_redis_url
UPSTASH_REDIS_TOKEN=your_redis_token

# BrightData Proxy (Optional but recommended for scraping)
BRIGHT_DATA_USERNAME=your_username
BRIGHT_DATA_PASSWORD=your_password

# Email Service (Gmail or other SMTP)
EMAIL_USER=your_email_address
EMAIL_PASSWORD=your_app_password_or_password

# API Keys
SERPAPI_KEY=your_serpapi_key
API_KEY=your_serpapi_key_alias # Some parts of the code use process.env.API_KEY
